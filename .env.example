# ==============================================================================
# Frontend (Vite / Vercel): chỉ đặt biến công khai tại đây
# ==============================================================================
# URL công khai của dự án Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co

# Tùy chọn: dùng khi API album-manifest được đặt ở một URL riêng
# VITE_GALLERY_API_URL=https://your-project.supabase.co/functions/v1/album-manifest

# ==============================================================================
# Server-side Supabase Edge Functions Secrets
# Không đặt các biến dưới đây trong .env.local hay đặt tiền tố VITE_.
# Thiết lập trên Supabase bằng lệnh: supabase secrets set KEY=VALUE
# ==============================================================================
# URL production của LiveGallery trên Vercel (dùng làm link QR và nguồn CORS mặc định cho album-manifest)
# LIVE_GALLERY_URL=https://your-livegallery.vercel.app
#
# Danh sách nguồn Photobooth được phép gọi album-publish (phân tách bằng dấu phẩy)
# ALLOWED_PHOTOBOOTH_ORIGINS=https://photobooth-itmo.vercel.app
#
# Tùy chọn: danh sách nguồn LiveGallery được phép gọi album-manifest (mặc định dùng LIVE_GALLERY_URL)
# ALLOWED_GALLERY_ORIGINS=https://your-livegallery.vercel.app
#
# Tùy chọn: chỉ đặt "true" ở môi trường dev local để cho phép http://localhost:* gọi Edge Functions
# ALLOW_LOCALHOST_ORIGINS=false
#
# Khóa bí mật riêng cho HMAC uploadToken và băm IP (nên tách riêng khỏi SUPABASE_SERVICE_ROLE_KEY; tạo 32+ byte ngẫu nhiên)
# ALBUM_SIGNING_SECRET=replace_with_32_plus_random_bytes
#
# Tùy chọn: cầu dao giới hạn tổng số album tạo trên toàn hệ thống trong 1 giờ (mặc định 1200)
# GLOBAL_UPLOAD_LIMIT_PER_HOUR=1200
#
# Cloudflare R2 (gói miễn phí: 10 GB lưu trữ, miễn phí băng thông tải ra).
# Tạo Token chỉ có quyền Object Read & Write cho đúng bucket riêng tư này.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=khoanhkhac-albums
# Tùy chọn: trần dung lượng R2 tối đa tính theo byte (mặc định 9500000000 = 9.5 GB; đặt 0 để tạm dừng upload)
# R2_MAX_STORAGE_BYTES=9500000000
